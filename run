#!/bin/bash
# Simple wrapper script to build and run tunnel-dash
# Usage: ./run --host my-server
#        ./run --server example.com --user admin

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Build if binary doesn't exist or if source files are newer
if [ ! -f "./tunnel-dash" ] || [ "$(find ./cmd ./pkg -type f -name '*.go' -newer ./tunnel-dash 2>/dev/null | head -1)" ]; then
    echo "Building tunnel-dash..."
    make build > /dev/null 2>&1 || make build
fi

# Run with all passed arguments
exec ./tunnel-dash "$@"


